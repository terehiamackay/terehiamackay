# ── Slack ──────────────────────────────────────────────────────────────────
# Bot token (xoxb-…) – from "OAuth & Permissions" in your Slack app settings.
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing secret – from "Basic Information" in your Slack app settings.
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-level token (xapp-…) – needed for Socket Mode.
# Create one under "Basic Information → App-Level Tokens" with the
# connections:write scope.
SLACK_APP_TOKEN=xapp-your-app-token-here

# ── Jira ───────────────────────────────────────────────────────────────────
# Base URL of your Jira instance (cloud or server).
JIRA_SERVER=https://your-org.atlassian.net

# Atlassian account email associated with the API token below.
JIRA_EMAIL=you@example.com

# API token – create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token-here

# Key of the Jira project to create tickets in (e.g. ENG, OPS, PLAT).
JIRA_PROJECT_KEY=ENG

# Issue type to create (default: Task).  Change to Bug, Story, etc. if needed.
JIRA_ISSUE_TYPE=Task
